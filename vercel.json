{
  "framework": "vite",
  "rewrites": [
    { "source": "/api/academic-courses/:id", "destination": "/api/academic-courses?id=:id" },
    { "source": "/api/schedule/:id", "destination": "/api/schedule?id=:id" },
    { "source": "/api/mood/:id", "destination": "/api/mood?id=:id" },
    { "source": "/((?!api/).*)", "destination": "/index.html" }
  ]
}
